{
  "manifest_version": 3,
  "name": "Nurse Voice EMR Transfer",
  "version": "0.1.0",
  "description": "Transfers a Nurse Voice note into a selected EMR text field.",
  "permissions": ["contextMenus"],
  "host_permissions": [
    "https://*/*",
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["src/content.js"]
  }]
}
